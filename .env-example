# Use fast resolver in Expo
EXPO_USE_FAST_RESOLVER=1

# ✅ Clerk - Auth configuration
# Replace with your actual Clerk publishable key from your Clerk dashboard
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# ✅ Firebase - Project configuration
# Replace the following with values from your Firebase project settings

# Firebase Web API Key
EXPO_FIREBASE_API_KEY=your-firebase-api-key

# Firebase Auth Domain (typically: your-project-id.firebaseapp.com)
EXPO_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
EXPO_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket (typically: your-project-id.appspot.com)
EXPO_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Cloud Messaging Sender ID
EXPO_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id

# Firebase App ID
EXPO_FIREBASE_APP_ID=your-firebase-app-id

# Firebase Measurement ID (used for analytics)
EXPO_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id
